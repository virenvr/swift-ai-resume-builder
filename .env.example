# Copy this file to .env.local and fill in values:
#   cp .env.example .env.local

# Your name — used only to label generated files (Resume_{Your_Name}_{Company}.pdf).
# Leave blank to get plain "Resume_{Company}.pdf". Exposed to the browser (NEXT_PUBLIC_).
NEXT_PUBLIC_RESUME_OWNER_NAME=

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------
# Pick one: gemini | anthropic | openai | openai-compatible
# Then fill in that provider's key below. The other keys can stay blank.
# Logging in from the browser extension overrides this whole section until you log out.
LLM_PROVIDER=gemini

# Optional model overrides. Leave blank to use the provider's defaults below.
#   PRO   = heavier steps (gap analysis, tailoring, Make MetaData)
#   FLASH = lighter steps (parsing, keywords, compression, scoring, summaries)
# Set both to the same cheap model to spend the least.
LLM_MODEL_PRO=
LLM_MODEL_FLASH=

# gemini: Google Gemini. Defaults: PRO and FLASH = gemini-2.5-flash
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# anthropic: Claude. Defaults: PRO = claude-sonnet-5-5, FLASH = claude-haiku-5-5
# https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# openai: ChatGPT models. Defaults: PRO and FLASH = gpt-6-luna
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# openai-compatible: any other service with an OpenAI-style API, including local
# models. Set LLM_MODEL_PRO and LLM_MODEL_FLASH too; this provider has no defaults.
# Check each service's docs for its current URL and model IDs. Common URLs:
#   OpenRouter  https://openrouter.ai/api/v1
#   Groq        https://api.groq.com/openai/v1
#   DeepSeek    https://api.deepseek.com
#   Ollama      http://localhost:11434/v1   (local, no key needed)
LLM_BASE_URL=
LLM_API_KEY=

# true: use local mocks, so you can explore the UI with no API key.
# false: call the provider above. Unset: use mocks only if that provider has no key.
DEMO_MODE=true

# Application tracker backend: local (default) | redis | supabase
# "local" stores records as JSON under data/applications/ (gitignored).
# redis/supabase are placeholders for a future cloud swap.
TRACKER_STORE=local

# Optional: Google Sheet tracking from the browser extension. See "Track applications
# in a Google Sheet" in the README for how to create these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Placeholders for later cloud backends (leave unset while using local):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Tracker pace goals (exposed to the /applications analytics panel).
# Weeks are Monday–Sunday (local calendar). Set to 0 to hide a goal meter.
NEXT_PUBLIC_TRACKER_DAILY_GOAL=5
NEXT_PUBLIC_TRACKER_WEEKLY_GOAL=25
NEXT_PUBLIC_TRACKER_MONTHLY_GOAL=100
NEXT_PUBLIC_TRACKER_LIFETIME_GOAL=0
